#!/bin/sh
# Renderizado pelo módulo service-ec2: roda a imagem OCI do serviço, o mesmo
# artefato de ECS e EKS (ADR 0008).
set -eu

IMAGE='${image}'
REGISTRY='${registry}'
REGISTRY_ALIAS='${registry_alias}'
REGION='${region}'
NAME='${container_name}'
PORT='${container_port}'
HEALTH_PATH='${health_check_path}'
DOCKER_TMPFS_SIZE='${docker_tmpfs_size}'

log() { echo "[user-data] $*"; }

install_docker() {
  if command -v dockerd >/dev/null 2>&1; then return 0; fi
  if command -v apk >/dev/null 2>&1; then
    apk add --no-cache docker-engine docker-cli
  elif command -v dnf >/dev/null 2>&1; then
    dnf install -y docker
  elif command -v apt-get >/dev/null 2>&1; then
    apt-get update -q && apt-get install -y -q docker.io
  else
    log "sem gerenciador de pacotes conhecido para instalar o Docker"
    exit 1
  fi
}

configure_local_registry() {
  [ -n "$REGISTRY_ALIAS" ] || return 0
  # WHY: no Floci o ECR responde em <conta>.dkr.ecr.<região>.localhost:4566,
  # nome que dentro da instância resolveria para ela mesma; o alias aponta
  # para o Floci na rede Docker, e esse registry não tem TLS.
  ip=$(getent hosts "$REGISTRY_ALIAS" | awk '{ print $1; exit }')
  [ -n "$ip" ] || { log "o alias $REGISTRY_ALIAS não resolve"; exit 1; }
  echo "$ip $${REGISTRY%%:*}" >> /etc/hosts
  mkdir -p /etc/docker
  printf '{"insecure-registries":["%s"]}\n' "$REGISTRY" > /etc/docker/daemon.json
}

start_docker() {
  if docker info >/dev/null 2>&1; then return 0; fi
  if [ -d /run/systemd/system ]; then
    systemctl enable --now docker
  else
    # WHY: sem systemd a instância é um container (Floci). Overlay sobre
    # overlay falha no Docker aninhado, então o /var/lib/docker vai para tmpfs.
    if awk '$2 == "/" && $3 == "overlay" { found = 1 } END { exit !found }' /proc/mounts; then
      mkdir -p /var/lib/docker
      awk '$2 == "/var/lib/docker" { found = 1 } END { exit !found }' /proc/mounts \
        || mount -t tmpfs -o "size=$DOCKER_TMPFS_SIZE" tmpfs /var/lib/docker
    fi
    nohup dockerd >/var/log/dockerd.log 2>&1 &
  fi
  attempt=0
  until docker info >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    [ "$attempt" -le 60 ] || { log "o dockerd não respondeu em 60 s"; exit 1; }
    sleep 1
  done
}

login_registry() {
  [ -z "$REGISTRY_ALIAS" ] || return 0
  aws ecr get-login-password --region "$REGION" \
    | docker login --username AWS --password-stdin "$REGISTRY"
}

run_service() {
  docker pull "$IMAGE"
  docker rm -f "$NAME" >/dev/null 2>&1 || true
  # NOTE: rede host para o processo escutar no endereço privado da instância,
  # que é o alvo registrado no target group.
  docker run -d --name "$NAME" --restart unless-stopped --network host \
    -e "PORT=$PORT"%{ for key, value in environment } \
    -e '${key}=${replace(value, "'", "'\\''")}'%{ endfor } \
    "$IMAGE"
}

wait_healthy() {
  url="http://127.0.0.1:$PORT$HEALTH_PATH"
  attempt=0
  until wget -q -O /dev/null "$url" 2>/dev/null || curl -fsS -o /dev/null "$url" 2>/dev/null; do
    attempt=$((attempt + 1))
    if [ "$attempt" -gt 60 ]; then
      log "o serviço não respondeu em $url"
      docker logs --tail 50 "$NAME" || true
      exit 1
    fi
    sleep 1
  done
  log "serviço saudável em $url"
}

install_docker
configure_local_registry
start_docker
login_registry
run_service
wait_healthy
