# Ambiente AWS local (Floci). Copie para .env para customizar; o .env é
# ignorado pelo git. Os valores abaixo são os mesmos padrões do compose.

# Região dos recursos e dos ARNs. Credenciais são fictícias (test/test).
AWS_REGION=us-east-1

# ── Floci ────────────────────────────────────────────────────────────────────
# memory | persistent | hybrid | wal. "persistent" grava a cada mudança.
FLOCI_STORAGE_MODE=persistent
# Timeout padrão das Lambdas, em segundos.
FLOCI_LAMBDA_TIMEOUT=60
# Monta o código direto do disco (S3Bucket=hot-reload). Ver README.
FLOCI_LAMBDA_HOT_RELOAD=false
# Vazio mantém localhost:4566 nas URLs devolvidas. Só mude com motivo (README).
FLOCI_HOSTNAME=
# false faz o CloudFormation falhar em tipos de recurso que o Floci não
# implementa, em vez de aceitá-los sem criar nada (stub silencioso).
FLOCI_CFN_ALLOW_STUBS=true
# Porta do host (só loopback) para o listener HTTP :80 dos ALBs. Evite 8080,
# que é a porta padrão dos serviços rodando no host.
FLOCI_ALB_HTTP_PORT=8088

# ── Bootstrap (container floci-bootstrap) ───────────────────────────────────
# Segundos de espera pelo Floci antes de falhar.
FLOCI_WAIT_TIMEOUT=120
# Prefixo canônico dos parâmetros SSM: /<LOCAL_APP>/<LOCAL_STAGE>/<AWS_REGION>/...
LOCAL_APP=playground
LOCAL_STAGE=local
# Domínio SSM dos parâmetros que cada recurso semeado publica sobre si mesmo.
FLOCI_SEED_SSM_DOMAIN=shared

# Listas separadas por vírgula. Variável vazia desliga o seed; todos são
# idempotentes. Recurso que o Floci declara não suportar vira aviso; qualquer
# outra falha de seed derruba o bootstrap, depois de rodar todos os seeds.
FLOCI_SEED_BUCKETS=playground-local-uploads
# Cada fila ganha uma DLQ <nome>-dlq com redrive após N recebimentos (inteiro de
# 1 a 1000) e VisibilityTimeout de 180 s (6x o timeout de 29 s das Lambdas).
FLOCI_SEED_QUEUES=playground-local-sample-events
FLOCI_SEED_QUEUE_MAX_RECEIVES=5
# Tabelas mínimas (chave de partição "pk", string). Ex.: playground-local-items
FLOCI_SEED_TABLES=
# dominio/recurso/atributo=valor. O valor não pode conter vírgula.
FLOCI_SEED_SSM_PARAMETERS="backoffice/app/name=Playground Backoffice"
