# Servidor de mock da API do painel (Mockoon). Copie para .env para
# customizar; o .env é ignorado pelo git. Os valores abaixo são os mesmos
# padrões do compose.

# Porta do host, só em loopback. O painel aponta para ela em
# NEXT_PUBLIC_API_URL (http://127.0.0.1:4010).
BACKOFFICE_MOCK_PORT=4010

# Token local e fictício da API administrativa do Mockoon, usada para voltar
# os dados ao estado inicial. Não é segredo e não vale fora desta máquina.
BACKOFFICE_MOCK_ADMIN_TOKEN=local-mock-token
