{
  "name": "backoffice-mock",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backoffice-mock/src",
  "tags": ["scope:backoffice", "type:tool"],
  "targets": {
    "generate-environment": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node src/mockoon-environment.mjs"
      }
    },
    "up": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "docker compose up -d --wait"
      }
    },
    "down": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "docker compose down --remove-orphans"
      }
    },
    "reset": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash scripts/reset.sh"
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "docker compose logs -f --tail=200"
      }
    },
    "status": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "docker compose ps -a"
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash scripts/validate.sh"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash scripts/smoke.sh"
      }
    }
  }
}
