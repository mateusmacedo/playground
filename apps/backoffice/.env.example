# Variáveis públicas do painel: entram no bundle do navegador no build, então nada de segredo aqui.
# Copie para .env.local e ajuste por ambiente.
NEXT_PUBLIC_APP_NAME=Backoffice
# Stage da stack, um dos valores de `AppStage` (src/core/config/app-config.ts): local, dev, homolog ou prod.
NEXT_PUBLIC_STAGE=local
# Endereço base da API do painel, http ou https, sem barra no fim. Sem valor, o painel guarda tudo no navegador
# (localStorage). O exemplo aponta para o servidor de mock local.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4010
