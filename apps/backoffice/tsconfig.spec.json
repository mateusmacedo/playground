{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "rootDir": ".",
    "tsBuildInfoFile": "./out-tsc/vitest/tsconfig.tsbuildinfo",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ]
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "specs/**/*.ts",
    "specs/**/*.tsx",
    "specs/**/*.js",
    "specs/**/*.jsx",
    "index.d.ts",
    "next-env.d.ts"
  ],
  "exclude": ["out-tsc", "dist", "node_modules", ".next"]
}
