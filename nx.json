{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.{js,cjs,mjs}",
      "!{workspaceRoot}/eslint.config.mjs",
      "!{workspaceRoot}/biome.json",
      "!{projectRoot}/vitest.config.{js,cjs,mjs,ts,cts,mts}",
      "!{projectRoot}/playwright.config.{js,cjs,mjs,ts,cts,mts}",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/**/*_test.go",
      "!{projectRoot}/src/test/**/*",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/biome.json",
      "{workspaceRoot}/pnpm-workspace.yaml"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "startTargetName": "start",
        "buildTargetName": "build",
        "devTargetName": "dev",
        "serveStaticTargetName": "serve-static",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      }
    },
    {
      "plugin": "@nx/docker",
      "options": {
        "buildTarget": "docker:build",
        "runTarget": "docker:run"
      }
    },
    {
      "plugin": "@nx/gradle",
      "options": {
        "ciTestTargetName": "test-ci"
      }
    },
    {
      "plugin": "./tools/serverless",
      "options": {
        "defaultConfiguration": "floci",
        "defaultGoArchitecture": "arm64"
      }
    }
  ],
  "analytics": false,
  "nxCloudId": "6af884afbe866a0bcfdaefce",
  "sync": {
    "applyChanges": true
  },
  "parallel": 3,
  "release": {
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      }
    },
    "changelog": {
      "automaticFromRef": true,
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": "github"
      }
    },
    "git": {
      "commitMessage": "chore(release): publish [skip ci]"
    },
    "groups": {
      "services-js": {
        "projects": ["tag:stack:ts"]
      },
      "services-git-tag": {
        "projects": ["tag:platform:serverless", "!tag:stack:ts"],
        "version": {
          "versionActions": "./tools/release/git-tag-version-actions.cjs"
        }
      }
    }
  },
  "targetDefaults": {
    "*": [
      {
        "filter": { "plugin": "@nx/gradle" },
        "inputs": [
          "...",
          "{workspaceRoot}/settings.gradle",
          "{workspaceRoot}/build.gradle",
          "{projectRoot}/build.gradle"
        ]
      }
    ],
    "build": [
      {
        "dependsOn": ["^build"],
        "cache": true
      },
      {
        "filter": { "plugin": "@nx/next/plugin" },
        "inputs": [
          "production",
          "^production",
          { "env": "NEXT_PUBLIC_API_URL" },
          { "env": "NEXT_PUBLIC_APP_NAME" },
          { "env": "NEXT_PUBLIC_STAGE" }
        ]
      },
      {
        "filter": { "plugin": "@nx/js/typescript" },
        "inputs": ["production", "^production"]
      },
      {
        "filter": { "plugin": "@nx/gradle" },
        "inputs": [
          "...",
          "{workspaceRoot}/settings.gradle",
          "{workspaceRoot}/build.gradle",
          "{projectRoot}/build.gradle"
        ]
      }
    ],
    "test": [
      {
        "filter": { "plugin": "@nx/vitest" },
        "dependsOn": ["^build"],
        "inputs": ["...", { "env": "VITEST_COVERAGE" }]
      }
    ],
    "e2e": {
      "inputs": ["...", { "env": "E2E_ALL_BROWSERS" }]
    }
  },
  "generators": {
    "@nx/next": {
      "application": {
        "style": "scss",
        "linter": "eslint"
      }
    }
  }
}
