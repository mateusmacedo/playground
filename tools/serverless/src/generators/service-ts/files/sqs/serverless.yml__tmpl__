service: <%= serviceName %>

frameworkVersion: '4'

# WHY: o núcleo do Serverless v4 fala com CloudFormation e S3 pelo AWS SDK v2,
# que ignora AWS_ENDPOINT_URL; o plugin redireciona essas chamadas ao Floci.
plugins:
  - serverless-localstack

custom:
  localstack:
    stages:
      - local
    host: http://localhost
    edgePort: 4566
    autostart: false
  # WHY: sem retenção o grupo de logs da função nunca expira e o custo de
  # armazenamento só cresce; prod guarda mais para investigação.
  logRetentionInDays:
    prod: 30
  nxServerless:
    language: typescript
    type: sqs
    queue: <%= queue %>

provider:
  name: aws
  stage: ${opt:stage, 'local'}
  region: ${env:AWS_REGION, 'us-east-1'}
  runtime: <%= runtime %>
  architecture: ${env:SLS_ARCH, 'arm64'}
  memorySize: <%= memorySize %>
  timeout: <%= timeout %>
  logRetentionInDays: ${self:custom.logRetentionInDays.${sls:stage}, 7}
  environment:
    LOG_LEVEL: ${ssm:<%= ssmPrefix %>/${sls:stage}/${aws:region}/<%= serviceName %>/config/log-level, 'info'}
<%_ if (queue === 'external') { _%>
    QUEUE_URL: ${ssm:<%= ssmPrefix %>/${sls:stage}/${aws:region}/<%= queueParam %>/url}
<%_ } else { _%>
    QUEUE_URL:
      Ref: Queue
<%_ } _%>

functions:
  handler:
    handler: src/entrypoints/lambda.handler
    events:
      - sqs:
<%_ if (queue === 'external') { _%>
          # WHY: fila cujas mensagens importam é do Terraform (ADR 0004); o
          # serviço só declara o gatilho e lê o ARN do contrato no SSM.
          arn: ${ssm:<%= ssmPrefix %>/${sls:stage}/${aws:region}/<%= queueParam %>/arn}
<%_ } else { _%>
          arn:
            Fn::GetAtt: [Queue, Arn]
<%_ } _%>
          batchSize: 10
          functionResponseType: ReportBatchItemFailures
<%_ if (queue === 'owned') { _%>

# NOTE: só para fila descartável de um único consumidor, que pode morrer com a
# função; o `serverless remove` apaga a fila e as mensagens pendentes.
resources:
  Resources:
    Queue:
      Type: AWS::SQS::Queue
      Properties:
        QueueName: ${self:service}-${sls:stage}
        # A AWS recomenda visibilidade de pelo menos 6x o timeout da função.
        VisibilityTimeout: <%= timeout * 6 %>
        RedrivePolicy:
          deadLetterTargetArn:
            Fn::GetAtt: [DeadLetterQueue, Arn]
          maxReceiveCount: 5
    DeadLetterQueue:
      Type: AWS::SQS::Queue
      Properties:
        QueueName: ${self:service}-${sls:stage}-dlq
        MessageRetentionPeriod: 1209600
<%_ } _%>
