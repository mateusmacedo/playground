service: <%= serviceName %>

frameworkVersion: '4'

# WHY: o núcleo do Serverless v4 fala com CloudFormation e S3 pelo AWS SDK v2,
# que ignora AWS_ENDPOINT_URL; o plugin redireciona essas chamadas ao Floci.
plugins:
  - serverless-localstack

custom:
  localstack:
    stages:
      - local
    host: http://localhost
    edgePort: 4566
    autostart: false
  # WHY: sem retenção o grupo de logs da função nunca expira e o custo de
  # armazenamento só cresce; prod guarda mais para investigação.
  logRetentionInDays:
    prod: 30
  nxServerless:
    language: go
    type: scheduled
    goPackage: cmd/<%= serviceName %>

provider:
  name: aws
  stage: ${opt:stage, 'local'}
  region: ${env:AWS_REGION, 'us-east-1'}
  runtime: <%= runtime %>
  architecture: ${env:SLS_ARCH, '<%= awsArchitecture %>'}
  memorySize: <%= memorySize %>
  timeout: <%= timeout %>
  logRetentionInDays: ${self:custom.logRetentionInDays.${sls:stage}, 7}
  environment:
    LOG_LEVEL: ${ssm:<%= ssmPrefix %>/${sls:stage}/${aws:region}/<%= serviceName %>/config/log-level, 'info'}

package:
  individually: true

functions:
  handler:
    handler: bootstrap
    package:
      artifact: .bin/bootstrap.zip
    # WHY: o agendamento invoca a Lambda de forma assíncrona; sem estes limites
    # valem os padrões da AWS (2 retentativas, evento de até 6 h), e um job
    # que falha rodaria de novo depois da execução seguinte. Acompanhe o
    # `schedule` ao mudar a frequência.
    maximumRetryAttempts: 1
    maximumEventAge: 3600
    events:
      - schedule:
          rate: ${ssm:<%= ssmPrefix %>/${sls:stage}/${aws:region}/<%= serviceName %>/config/schedule, 'rate(1 hour)'}
