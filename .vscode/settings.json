{
  "editor.defaultFormatter": "fronterior.biome-monorepo",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "[typescript]": { "editor.defaultFormatter": "fronterior.biome-monorepo" },
  "[typescriptreact]": {
    "editor.defaultFormatter": "fronterior.biome-monorepo"
  },
  "[javascript]": { "editor.defaultFormatter": "fronterior.biome-monorepo" },
  "[javascriptreact]": {
    "editor.defaultFormatter": "fronterior.biome-monorepo"
  },
  "[json]": { "editor.defaultFormatter": "fronterior.biome-monorepo" },
  "[jsonc]": { "editor.defaultFormatter": "fronterior.biome-monorepo" },
  "[css]": { "editor.defaultFormatter": "fronterior.biome-monorepo" },
  "[scss]": { "editor.defaultFormatter": "fronterior.biome-monorepo" },
  "[yaml]": { "editor.defaultFormatter": "fronterior.biome-monorepo" },
  "[markdown]": {
    "editor.defaultFormatter": "fronterior.biome-monorepo"
  },
  "java.compile.nullAnalysis.mode": "disabled",
  "terraform.languageServer.indexing.ignoreDirectoryNames": [
    "node_modules",
    ".nx",
    "tmp",
    "dist",
    "build",
    ".gradle",
    ".next",
    ".serverless"
  ],
  "java.configuration.updateBuildConfiguration": "automatic"
}
