{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "defaultBranch": "main",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/dist",
      "!!**/.next",
      "!!**/coverage",
      "!!**/test-output",
      "!!**/out-tsc",
      "!!**/.nx",
      "!!**/node_modules",
      "!!**/tmp",
      "!**/*.tfstate*",
      "!!**/.terraform",
      "!!**/.gradle",
      "!!**/build",
      "!!**/.remember",
      "!**/*.tsbuildinfo",
      "!**/pnpm-lock.yaml",
      "!**/next-env.d.ts",
      "!**/.github/skills",
      "!**/.github/prompts",
      "!**/.github/agents",
      "!**/.agents",
      "!**/.cursor",
      "!**/.gemini",
      "!**/.opencode",
      "!**/.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended",
      "playwright": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "yaml": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    },
    "formatter": {
      "proseWrap": "preserve"
    }
  }
}
