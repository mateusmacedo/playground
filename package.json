{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "lefthook install",
    "format": "biome check --write .",
    "format:check": "biome ci .",
    "lint": "node tools/ai/check-instructions.mjs && biome lint . && nx run-many -t lint",
    "check": "nx affected -t lint typecheck test --base=origin/main --parallel=2",
    "check:full": "biome ci . && VITEST_COVERAGE=1 nx run-many -t lint typecheck test build fmt validate spotlessCheck --parallel=3",
    "e2e:full": "E2E_ALL_BROWSERS=1 nx run-many -t e2e",
    "release:dry": "nx release --dry-run --skip-publish",
    "release": "if [ -z \"$CI\" ]; then echo 'erro: pnpm release só roda no CI (workflow Release). Para simular localmente: pnpm release:dry' >&2; exit 1; fi; nx release --yes"
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/config-nx-scopes": "catalog:",
    "@nx/devkit": "catalog:",
    "@nx/docker": "catalog:",
    "@nx/eslint": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@nx/gradle": "catalog:",
    "@nx/js": "catalog:",
    "@nx/next": "catalog:",
    "@nx/playwright": "catalog:",
    "@nx/vitest": "catalog:",
    "@playwright/test": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@swc/helpers": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/aws-lambda": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "lefthook": "catalog:",
    "nx": "catalog:",
    "sass": "catalog:",
    "serverless": "catalog:",
    "serverless-localstack": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
